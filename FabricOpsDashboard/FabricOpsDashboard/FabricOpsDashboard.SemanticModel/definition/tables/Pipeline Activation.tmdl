		lineageTag: 94f4d2ee-0c83-5a85-b61d-3469f7f3c15d
		sourceColumn: submitted_dry_run_operation_count
		summarizeBy: none
		formatString: #,0

	partition 'Pipeline Activation' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT CONCAT(a.execution_workspace_id,'|',a.pipeline_id) pipeline_key,a.pipeline_id,a.approval_id,a.submission_id,a.revision,a.status,a.decision_kind,a.expected_active_version,a.restores_promotion_id,a.expires_at,a.decided_at,a.review_note,a._committed_by committed_by,a._notebook_name commit_notebook_name,JSON_VALUE(a.package_json,'$.dry_run.run_id') submitted_dry_run_id,JSON_VALUE(a.package_json,'$.dry_run.status') submitted_dry_run_status,CASE JSON_VALUE(a.package_json,'$.dry_run.boundary_completed') WHEN 'true' THEN CAST(1 AS bit) WHEN 'false' THEN CAST(0 AS bit) END submitted_dry_run_boundary_completed,(SELECT COUNT(1) FROM OPENJSON(a.package_json,'$.dry_run.operations')) submitted_dry_run_operation_count FROM [" & GovernanceSchemaSql & "].[METADATA_PIPELINE_ACTIVATION] a WHERE ('" & Text.Replace(WorkspaceFilter, "'", "''") & "'='' OR a.execution_workspace_id='" & Text.Replace(WorkspaceFilter, "'", "''") & "')",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true])
			in
			    Rows
