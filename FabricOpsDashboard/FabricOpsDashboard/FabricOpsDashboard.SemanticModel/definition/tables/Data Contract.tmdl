table 'Data Contract'
	lineageTag: ae24c1ee-6337-56cb-8b1b-d6635dda7558

	column 'Contract Key'
		dataType: string
		lineageTag: d5137c83-af32-5f5d-9b78-f2cdb9627dc6
		sourceColumn: contract_key

	column 'Contract ID'
		dataType: string
		lineageTag: 6aee4db2-64a1-556f-8904-b3ba96b8b3ff
		sourceColumn: contract_id

	column 'Contract Version'
		dataType: int64
		lineageTag: 25872ae3-f5f6-5e56-a3db-605d1ad312a7
		sourceColumn: contract_version
		summarizeBy: none
		formatString: #,0

	column 'Evidence Workspace ID'
		dataType: string
		lineageTag: 2657bcb7-ae79-5719-a61c-6c37a930f177
		sourceColumn: evidence_workspace_id

	column 'Processing Strategy'
		dataType: string
		lineageTag: 7f136a64-d714-5766-9a0b-7d4a3dc8f2fe
		sourceColumn: processing_strategy

	column 'Guardrail Count'
		dataType: int64
		lineageTag: d163d97b-9519-5ab7-9aad-4f893aaa0d05
		sourceColumn: guardrail_count
		summarizeBy: none
		formatString: #,0

	column 'Table Description'
		dataType: string
		lineageTag: 85f4b890-85ab-58b3-8a97-a63d31680479
		sourceColumn: table_description

	partition 'Data Contract' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT CONCAT(c.contract_id,'|',c.contract_version) contract_key,c.contract_id,c.contract_version,c.evidence_workspace_id,CASE WHEN p.is_valid=1 THEN JSON_VALUE(p.safe_json,'$.table.processing.load_strategy') END processing_strategy,CASE WHEN p.is_valid=1 THEN (SELECT COUNT(1) FROM OPENJSON(p.safe_json,'$.guardrails')) END guardrail_count,CASE WHEN p.is_valid=1 THEN (SELECT TOP(1) CASE WHEN ISJSON(e.value)=1 THEN JSON_VALUE(e.value,'$.value') END FROM OPENJSON(p.safe_json,'$.enrichment.table') e WHERE CASE WHEN ISJSON(e.value)=1 THEN JSON_VALUE(e.value,'$.enrichment_type') END='Description') END table_description FROM [" & GovernanceSchemaSql & "].[METADATA_DATA_CONTRACT] c CROSS APPLY (VALUES (CASE WHEN ISJSON(c.contract_payload_json)=1 THEN c.contract_payload_json ELSE N'{}' END,ISJSON(c.contract_payload_json))) p(safe_json,is_valid)",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true])
			in
			    Rows
