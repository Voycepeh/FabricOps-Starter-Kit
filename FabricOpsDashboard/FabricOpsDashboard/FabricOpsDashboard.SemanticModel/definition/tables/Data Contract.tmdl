table 'Data Contract'
	lineageTag: ae24c1ee-6337-56cb-8b1b-d6635dda7558

	column 'Contract Key'
		dataType: string
		lineageTag: d5137c83-af32-5f5d-9b78-f2cdb9627dc6
		sourceColumn: contract_key

	column 'Contract ID'
		dataType: string
		lineageTag: 6aee4db2-64a1-556f-8904-b3ba96b8b3ff
		sourceColumn: contract_id

	column 'Contract Version'
		dataType: int64
		lineageTag: 25872ae3-f5f6-5e56-a3db-605d1ad312a7
		sourceColumn: contract_version
		summarizeBy: none
		formatString: #,0

	column 'Table Name'
		dataType: string
		lineageTag: 684ab279-7e8c-5498-afd1-78f71a9bcb84
		sourceColumn: table_name

	column 'Committed By'
		dataType: string
		lineageTag: bd43fa91-5664-5d57-baa5-f5312e3809a9
		sourceColumn: committed_by

	column 'Commit Notebook Name'
		dataType: string
		lineageTag: 4d386c67-c853-5bf0-8335-092661287e0f
		sourceColumn: commit_notebook_name

	column 'Evidence Workspace ID'
		dataType: string
		lineageTag: 2657bcb7-ae79-5719-a61c-6c37a930f177
		sourceColumn: evidence_workspace_id

	column 'Processing Strategy'
		dataType: string
		lineageTag: 7f136a64-d714-5766-9a0b-7d4a3dc8f2fe
		sourceColumn: processing_strategy

	column 'Guardrail Count'
		dataType: int64
		lineageTag: d163d97b-9519-5ab7-9aad-4f893aaa0d05
		sourceColumn: guardrail_count
		summarizeBy: none
		formatString: #,0

	column 'Table Description'
		dataType: string
		lineageTag: 85f4b890-85ab-58b3-8a97-a63d31680479
		sourceColumn: table_description

	partition 'Data Contract' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT CONCAT(c.contract_id,'|',c.contract_version) contract_key,c.contract_id,c.contract_version,c.table_name,c._committed_by committed_by,c._notebook_name commit_notebook_name,c.evidence_workspace_id,c.contract_payload_json FROM [" & GovernanceSchemaSql & "].[METADATA_DATA_CONTRACT] c",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true]),
			    Payload = Table.AddColumn(Rows, "_payload", each try Json.Document([contract_payload_json]) otherwise null),
			    ReadField = (value as any, field as text) as any => if Value.Is(value, type record) then Record.FieldOrDefault(value, field, null) else null,
			    ProcessingStrategy = Table.AddColumn(Payload, "processing_strategy", each let value = ReadField(ReadField(ReadField([_payload], "table"), "processing"), "load_strategy") in if value = null then null else if Value.Is(value, type text) or Value.Is(value, type number) or Value.Is(value, type logical) then Text.From(value) else null, type nullable text),
			    GuardrailCount = Table.AddColumn(ProcessingStrategy, "guardrail_count", each let value = ReadField([_payload], "guardrails") in if Value.Is(value, type list) then List.Count(value) else if Value.Is(value, type record) then Record.FieldCount(value) else null, Int64.Type),
			    TableDescription = Table.AddColumn(GuardrailCount, "table_description", each let enrichmentSection = ReadField(ReadField([_payload], "enrichment"), "table"), items = if Value.Is(enrichmentSection, type list) then enrichmentSection else if Value.Is(enrichmentSection, type record) then {enrichmentSection} else {}, matches = List.Select(items, each ReadField(_, "enrichment_type") = "Description"), value = if List.IsEmpty(matches) then null else ReadField(matches{0}, "value") in if value = null then null else if Value.Is(value, type text) or Value.Is(value, type number) or Value.Is(value, type logical) then Text.From(value) else null, type nullable text),
			    WithoutPayload = Table.RemoveColumns(TableDescription, {"contract_payload_json", "_payload"}),
			    Typed = Table.TransformColumnTypes(WithoutPayload, {{"contract_version", Int64.Type}})
			in
			    Typed
