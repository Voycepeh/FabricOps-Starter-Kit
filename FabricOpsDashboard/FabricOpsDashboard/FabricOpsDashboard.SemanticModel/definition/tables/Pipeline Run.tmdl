		formatString: #,0

	column 'Fabric Notebook URL'
		dataType: string
		lineageTag: 41c98c8e-0ae3-502b-b7fc-86e68f6507d9
		sourceColumn: fabric_notebook_url
		dataCategory: WebUrl

	partition 'Pipeline Run' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT r.run_id,CONCAT(r.workspace_id,'|',r.pipeline_id) pipeline_key,r.pipeline_id,r.workspace_id,r._workspace_name workspace_name,r._notebook_name notebook_name,r.execution_identity,r.started_at,r.completed_at,CAST(r.started_at AS date) run_date,r.status,r.boundary_completed,r.pipeline_version,r.promotion_id,r.execution_mode,(SELECT COUNT(1) FROM OPENJSON(r.failures)) failure_count,CASE WHEN r.governed_notebook_id IS NULL OR r.governed_notebook_id='' THEN NULL ELSE CONCAT('https://app.fabric.microsoft.com/groups/',r.workspace_id,'/notebooks/',r.governed_notebook_id) END fabric_notebook_url FROM [" & EngineeringSchemaSql & "].[METADATA_PIPELINE_RUN] r WHERE r.started_at>=DATEADD(day,-" & Number.ToText(HistoryWindowDays) & ",SYSUTCDATETIME()) AND ('" & Text.Replace(WorkspaceFilter, "'", "''") & "'='' OR r.workspace_id='" & Text.Replace(WorkspaceFilter, "'", "''") & "')",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true])
			in
			    Rows
