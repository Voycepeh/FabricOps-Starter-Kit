model FabricOpsMetadata
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters
	annotation PBI_QueryGroupOrder = 0

queryGroup 'Connection helpers'
	annotation PBI_QueryGroupOrder = 1

queryGroup 'Canonical metadata'
	annotation PBI_QueryGroupOrder = 2

queryGroup 'Semantic dimensions'
	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["METADATA_DATA_STEWARD","METADATA_DATA_AGREEMENT","METADATA_DATA_CONTRACT","METADATA_DATA_CATALOGUE","METADATA_DATA_PROFILED","METADATA_DATA_PROFILED_FREQUENCY","METADATA_DATA_LINEAGE","METADATA_DATA_ACCESS","METADATA_PIPELINE_REGISTRY","METADATA_PIPELINE_RUN","METADATA_GUARDRAIL_RESULTS","METADATA_PROCESSING_STATE","DimTable","DimWorkspace","DimPipeline","pSqlEndpoint","pDatabaseName","pGovernanceSchema","pEngineeringSchema","pLoadComplexBearingTables"]

ref table METADATA_DATA_STEWARD
ref table METADATA_DATA_AGREEMENT
ref table METADATA_DATA_CONTRACT
ref table METADATA_DATA_CATALOGUE
ref table METADATA_DATA_PROFILED
ref table METADATA_DATA_PROFILED_FREQUENCY
ref table METADATA_DATA_LINEAGE
ref table METADATA_DATA_ACCESS
ref table METADATA_PIPELINE_REGISTRY
ref table METADATA_PIPELINE_RUN
ref table METADATA_GUARDRAIL_RESULTS
ref table METADATA_PROCESSING_STATE
ref table Date
ref table DimTable
ref table DimWorkspace
ref table DimPipeline
ref table _Measures
