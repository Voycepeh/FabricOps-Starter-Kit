		lineageTag: 63b887b9-e7c4-5998-acf4-6673b899c8be

	measure 'Steward Coverage' = ```
			DIVIDE(DISTINCTCOUNT(METADATA_DATA_AGREEMENT[provider_steward_id]) + DISTINCTCOUNT(METADATA_DATA_AGREEMENT[recipient_steward_id]), 2 * [Active Stewards])
			```
		formatString: 0.0%
		displayFolder: Governance
		lineageTag: 85fab728-3b53-534c-bade-62e538b7e9ad

	measure Agreements = ```
