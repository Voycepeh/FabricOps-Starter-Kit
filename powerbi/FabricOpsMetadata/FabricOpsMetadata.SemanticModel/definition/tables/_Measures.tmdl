		formatString: #,0
		displayFolder: Data Quality
		lineageTag: a45d0dc6-96b9-50a5-bd4d-068d67e86a0e

	measure 'Weighted Null Percent' = ```
			DIVIDE(SUM(METADATA_DATA_PROFILED[null_count]), SUM(METADATA_DATA_PROFILED[row_count]))
			```
		formatString: 0.00%
		displayFolder: Data Quality
		lineageTag: 6d1f70c3-6b27-5899-8361-8aaeb167414e

	measure 'Average Distinct Percent' = ```
			DIVIDE(AVERAGE(METADATA_DATA_PROFILED[distinct_percent]), 100)
			```
		formatString: 0.00%
		displayFolder: Data Quality
		lineageTag: 06cf5c53-d2df-5aa2-8551-a1502b4a2ce6

	measure 'Frequent Values' = ```
