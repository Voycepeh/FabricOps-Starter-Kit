	measure 'Guardrail Results' = ```
			DISTINCTCOUNT(METADATA_GUARDRAIL_RESULTS[guardrail_result_id])
			```
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 8609433d-f445-5566-9a14-e044c8cea26d

	measure 'Guardrail Passed' = ```
			CALCULATE([Guardrail Results], LOWER(METADATA_GUARDRAIL_RESULTS[status]) IN {"passed", "pass", "success", "succeeded", "compliant"})
			```
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: b201ab91-0f99-5c4b-b73a-ed1b3e1f335e

	measure 'Guardrail Failed' = ```
			CALCULATE([Guardrail Results], LOWER(METADATA_GUARDRAIL_RESULTS[status]) IN {"failed", "fail", "failure", "noncompliant"})
			```
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 7c84d947-e54b-5d3b-936f-3366c652a86a

	measure 'Guardrail Pass Rate' = ```
			DIVIDE([Guardrail Passed], [Guardrail Results])
			```
		formatString: 0.0%
		displayFolder: Data Quality
		lineageTag: 76cc2612-6a5c-58cb-908a-9ca0414cdea0

	measure 'Data Quality Indicators' = ```
			[Profile Observations] + [Guardrail Results]
			```
		formatString: #,0
		displayFolder: Overview
		lineageTag: 191af78a-e58a-5bcc-90e6-7ad474bf02c4

	measure 'Active Stewards' = ```
			CALCULATE(DISTINCTCOUNT(METADATA_DATA_STEWARD[steward_id]), METADATA_DATA_STEWARD[is_active] = TRUE())
			```
		formatString: #,0
