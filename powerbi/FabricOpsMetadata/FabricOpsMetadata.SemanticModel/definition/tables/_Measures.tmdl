		displayFolder: Overview
		lineageTag: d2f290e6-0951-5aac-90f6-402975e2ee9c

	measure 'Active Tables' = ```
			CALCULATE(COUNTROWS(DimTable), DimTable[is_active] = TRUE())
			```
		formatString: #,0
		displayFolder: Overview
		lineageTag: 5fc8a722-6d18-5629-ae01-1bed79bf014e

	measure 'Registered Workspaces' = ```
			DISTINCTCOUNT(DimWorkspace[workspace_id])
			```
		formatString: #,0
		displayFolder: Overview
		lineageTag: 06aa00a8-7842-5a76-994f-6a5935464689

	measure 'Frozen Contracts' = ```
			CALCULATE(DISTINCTCOUNT(METADATA_DATA_CONTRACT[contract_key]), METADATA_DATA_CONTRACT[status] = "Frozen")
			```
		formatString: #,0
		displayFolder: Governance
		lineageTag: 85190c16-e03a-5e35-80a3-547989a4fe38

	measure 'Draft Contracts' = ```
			CALCULATE(DISTINCTCOUNT(METADATA_DATA_CONTRACT[contract_key]), METADATA_DATA_CONTRACT[status] = "Draft")
			```
		formatString: #,0
		displayFolder: Governance
		lineageTag: ef597745-3c62-5cb4-8b7d-e46facadce84

	measure 'Pipeline Executions' = ```
			DISTINCTCOUNT(METADATA_PIPELINE_RUN[run_id])
			```
		formatString: #,0
		displayFolder: Pipeline Operations
		lineageTag: 92cc6634-be9c-5ca7-8037-6c86699c30da

	measure 'Successful Runs' = ```
			CALCULATE([Pipeline Executions], LOWER(METADATA_PIPELINE_RUN[status]) IN {"succeeded", "success", "completed"})
			```
		formatString: #,0
		displayFolder: Pipeline Operations
		lineageTag: 5375781d-a572-50b4-964a-8e34b87c52e2

	measure 'Failed Runs' = ```
			CALCULATE([Pipeline Executions], LOWER(METADATA_PIPELINE_RUN[status]) IN {"failed", "failure", "error"})
			```
		formatString: #,0
		displayFolder: Pipeline Operations
		lineageTag: b7338984-3c63-584c-bda1-8f733c11e692

	measure 'Pipeline Success Rate' = ```
			DIVIDE([Successful Runs], [Pipeline Executions])
			```
		formatString: 0.0%
		displayFolder: Pipeline Operations
		lineageTag: ac5dce42-cff4-55f7-aed1-ec1c5ada668f

	measure 'Average Run Duration Seconds' = ```
			AVERAGEX(FILTER(METADATA_PIPELINE_RUN, NOT ISBLANK(METADATA_PIPELINE_RUN[completed_at])), DATEDIFF(METADATA_PIPELINE_RUN[started_at], METADATA_PIPELINE_RUN[completed_at], SECOND))
			```
		formatString: #,0.0
		displayFolder: Pipeline Operations
		lineageTag: 1793d22d-8f16-5d8f-b191-28d2f6e5d4b3

	measure 'Profile Observations' = ```
			DISTINCTCOUNT(METADATA_DATA_PROFILED[profile_id])
