	partition METADATA_PIPELINE_RUN = m
		mode: import
		queryGroup: 'Canonical metadata'
		source = ```
			let
			    Source = FabricOpsSqlTable(pEngineeringSchema, "METADATA_PIPELINE_RUN", {"run_id", "approval_id", "pipeline_id", "execution_mode", "workspace_id", "started_at", "completed_at", "status", "activation_revision", "boundary_completed", "warnings_json", "_committed_by", "_committed_at", "_workspace_id", "_workspace_name", "_notebook_id", "_notebook_name", "_metadata_lakehouse_name", "_activity_id"}, true),
			    Typed = Table.TransformColumnTypes(Source, {{"run_id", type text}, {"approval_id", type text}, {"pipeline_id", type text}, {"execution_mode", type text}, {"workspace_id", type text}, {"started_at", type datetime}, {"completed_at", type datetime}, {"status", type text}, {"activation_revision", type text}, {"boundary_completed", type logical}, {"warnings_json", type text}, {"_committed_by", type text}, {"_committed_at", type datetime}, {"_workspace_id", type text}, {"_workspace_name", type text}, {"_notebook_id", type text}, {"_notebook_name", type text}, {"_metadata_lakehouse_name", type text}, {"_activity_id", type text}}),
			    WithPipelineKey = Table.AddColumn(Typed, "workspace_pipeline_key", each Text.Combine(List.Transform({[workspace_id], [pipeline_id]}, each if _ = null then "" else Text.From(_)), "|"), type text),
			    WithRunDate = Table.AddColumn(WithPipelineKey, "run_date", each Date.From([started_at]), type date),
			    Result = WithRunDate
			in
			    Result
			```

