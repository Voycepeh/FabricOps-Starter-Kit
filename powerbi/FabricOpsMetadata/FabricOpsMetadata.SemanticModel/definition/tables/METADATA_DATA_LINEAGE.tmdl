	partition METADATA_DATA_LINEAGE = m
		mode: import
		queryGroup: 'Canonical metadata'
		source = ```
			let
			    Source = FabricOpsSqlTable(pEngineeringSchema, "METADATA_DATA_LINEAGE", {"lineage_id", "table_id", "table_name", "workspace_id", "pipeline_role", "_committed_by", "_committed_at", "_workspace_id", "_workspace_name", "_notebook_id", "_notebook_name", "_metadata_lakehouse_name", "_activity_id"}, false),
			    Typed = Table.TransformColumnTypes(Source, {{"lineage_id", type text}, {"table_id", type text}, {"table_name", type text}, {"workspace_id", type text}, {"pipeline_role", type text}, {"_committed_by", type text}, {"_committed_at", type datetime}, {"_workspace_id", type text}, {"_workspace_name", type text}, {"_notebook_id", type text}, {"_notebook_name", type text}, {"_metadata_lakehouse_name", type text}, {"_activity_id", type text}}),
			    WithTableKey = Table.AddColumn(Typed, "workspace_table_key", each Text.Combine(List.Transform({[workspace_id], [table_id]}, each if _ = null then "" else Text.From(_)), "|"), type text),
			    WithLineageDate = Table.AddColumn(WithTableKey, "lineage_observed_date", each Date.From([_committed_at]), type date),
			    Result = WithLineageDate
			in
			    Result
			```

