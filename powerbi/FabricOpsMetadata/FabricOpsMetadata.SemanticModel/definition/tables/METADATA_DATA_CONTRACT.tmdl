	partition METADATA_DATA_CONTRACT = m
		mode: import
		queryGroup: 'Canonical metadata'
		source = ```
			let
			    Source = FabricOpsSqlTable(pGovernanceSchema, "METADATA_DATA_CONTRACT", {"contract_id", "contract_version", "table_id", "table_name", "evidence_workspace_id", "contract_payload_json", "status", "_committed_by", "_committed_at", "_workspace_id", "_workspace_name", "_notebook_id", "_notebook_name", "_metadata_lakehouse_name", "_activity_id"}, false),
			    Typed = Table.TransformColumnTypes(Source, {{"contract_id", type text}, {"contract_version", Int64.Type}, {"table_id", type text}, {"table_name", type text}, {"evidence_workspace_id", type text}, {"contract_payload_json", type text}, {"status", type text}, {"_committed_by", type text}, {"_committed_at", type datetime}, {"_workspace_id", type text}, {"_workspace_name", type text}, {"_notebook_id", type text}, {"_notebook_name", type text}, {"_metadata_lakehouse_name", type text}, {"_activity_id", type text}}),
			    WithContractKey = Table.AddColumn(Typed, "contract_key", each Text.Combine(List.Transform({[contract_id], [contract_version]}, each if _ = null then "" else Text.From(_)), "|"), type text),
			    WithContractDate = Table.AddColumn(WithContractKey, "contract_committed_date", each Date.From([_committed_at]), type date),
			    Result = WithContractDate
			in
			    Result
			```

	annotation PBI_NavigationStepName = Navigation

