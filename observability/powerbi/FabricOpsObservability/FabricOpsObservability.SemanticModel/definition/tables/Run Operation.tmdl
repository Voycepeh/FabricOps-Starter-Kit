		lineageTag: 078824d7-0c0e-59bf-bbc2-171c1ef4f2d0
		sourceColumn: fabric_item_url
		dataCategory: WebUrl

	partition 'Run Operation' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT o.operation_key,r.run_id,CONCAT(COALESCE(o.destination_workspace_id,r.workspace_id),'|',o.table_id) table_key,o.table_id,o.pipeline_role,o.contract_id,o.contract_version,o.status,o.started_at,o.completed_at,o.destination_workspace_id,o.destination_item_id,o.destination_kind,o.destination_schema,o.destination_table_name,CASE WHEN o.destination_workspace_id IS NULL OR o.destination_item_id IS NULL OR LOWER(o.destination_kind) NOT IN ('lakehouse','warehouse') THEN NULL ELSE CONCAT('https://app.fabric.microsoft.com/groups/',o.destination_workspace_id,'/',LOWER(o.destination_kind),'s/',o.destination_item_id) END fabric_item_url FROM [" & EngineeringSchemaSql & "].[METADATA_PIPELINE_RUN] r CROSS APPLY OPENJSON(r.operations) WITH (operation_key nvarchar(400) '$.operation_key',table_id nvarchar(400) '$.table_id',pipeline_role nvarchar(50) '$.pipeline_role',contract_id nvarchar(400) '$.contract_id',contract_version bigint '$.contract_version',status nvarchar(80) '$.status',started_at datetime2 '$.started_at',completed_at datetime2 '$.completed_at',destination_workspace_id nvarchar(400) '$.destination.workspace_id',destination_item_id nvarchar(400) '$.destination.item_id',destination_kind nvarchar(80) '$.destination.kind',destination_schema nvarchar(400) '$.destination.schema',destination_table_name nvarchar(400) '$.destination.table_name') o WHERE r.started_at>=DATEADD(day,-" & Number.ToText(HistoryWindowDays) & ",SYSUTCDATETIME()) AND ('" & Text.Replace(WorkspaceFilter, "'", "''") & "'='' OR r.workspace_id='" & Text.Replace(WorkspaceFilter, "'", "''") & "')",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true])
			in
			    Rows
