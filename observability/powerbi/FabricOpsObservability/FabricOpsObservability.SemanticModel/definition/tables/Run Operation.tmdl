	partition 'Run Operation' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT o.operation_key,r.run_id,CONCAT(COALESCE(o.destination_workspace_id,r.workspace_id),'|',o.table_id) table_key,o.table_id,o.pipeline_role,o.read_mode,o.write_mode,COALESCE(o.metric_rows_read,o.rows_read) rows_read,o.columns,o.input_rows,o.input_columns,COALESCE(o.rows_committed,o.rows_written) rows_committed,o.rows_inserted,o.rows_updated,o.rows_unchanged,o.versions_inserted,o.versions_expired,o.total_target_rows,o.measurement_source,o.contract_id,o.contract_version,o.status,o.started_at,o.completed_at,o.destination_kind,o.destination_table_name,CASE WHEN o.destination_workspace_id IS NULL OR o.destination_item_id IS NULL OR LOWER(o.destination_kind) NOT IN ('lakehouse','warehouse') THEN NULL ELSE CONCAT('https://app.fabric.microsoft.com/groups/',o.destination_workspace_id,'/',LOWER(o.destination_kind),'s/',o.destination_item_id) END fabric_item_url FROM [" & EngineeringSchemaSql & "].[METADATA_PIPELINE_RUN] r CROSS APPLY OPENJSON(r.operations) WITH (operation_key nvarchar(400) '$.operation_key',table_id nvarchar(400) '$.table_id',pipeline_role nvarchar(50) '$.pipeline_role',read_mode nvarchar(100) '$.read_mode',write_mode nvarchar(100) '$.write_mode',rows_read bigint '$.rows_read',rows_written bigint '$.rows_written',metric_rows_read bigint '$.metrics.rows_read',columns bigint '$.metrics.columns',input_rows bigint '$.metrics.input_rows',input_columns bigint '$.metrics.input_columns',rows_committed bigint '$.metrics.rows_committed',rows_inserted bigint '$.metrics.rows_inserted',rows_updated bigint '$.metrics.rows_updated',rows_unchanged bigint '$.metrics.rows_unchanged',versions_inserted bigint '$.metrics.versions_inserted',versions_expired bigint '$.metrics.versions_expired',total_target_rows bigint '$.metrics.total_target_rows',measurement_source nvarchar(100) '$.metrics.measurement_source',contract_id nvarchar(400) '$.contract_id',contract_version bigint '$.contract_version',status nvarchar(80) '$.status',started_at datetime2 '$.started_at',completed_at datetime2 '$.completed_at',destination_workspace_id nvarchar(400) '$.destination.workspace_id',destination_item_id nvarchar(400) '$.destination.item_id',destination_kind nvarchar(80) '$.destination.kind',destination_table_name nvarchar(400) '$.destination.table_name') o WHERE r.started_at>=DATEADD(day,-" & Number.ToText(HistoryWindowDays) & ",SYSUTCDATETIME()) AND ('" & Text.Replace(WorkspaceFilter, "'", "''") & "'='' OR r.workspace_id='" & Text.Replace(WorkspaceFilter, "'", "''") & "')",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true])
			in
			    Rows
