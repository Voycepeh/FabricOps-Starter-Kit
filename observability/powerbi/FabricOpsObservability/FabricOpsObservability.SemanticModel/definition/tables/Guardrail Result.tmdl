	column 'Committed At'
		dataType: dateTime
		lineageTag: 26f258bf-5c23-5ca4-b6bf-801f902eb347
		sourceColumn: committed_at
		formatString: yyyy-MM-dd HH:mm

	partition 'Guardrail Result' = m
		mode: import
		source =
			let
			    Source = Sql.Database(MetadataServer, MetadataDatabase),
			    Query = "SELECT run_id,CONCAT(workspace_id,'|',table_id) table_key,table_name,contract_id,contract_version,status,can_continue,severity,guardrail_type,rule_type,action,reason,_committed_at committed_at FROM [" & EngineeringSchemaSql & "].[METADATA_GUARDRAIL_RESULTS] WHERE _committed_at>=DATEADD(day,-" & Number.ToText(HistoryWindowDays) & ",SYSUTCDATETIME()) AND ('" & Text.Replace(WorkspaceFilter, "'", "''") & "'='' OR workspace_id='" & Text.Replace(WorkspaceFilter, "'", "''") & "')",
			    Rows = Value.NativeQuery(Source, Query, null, [EnableFolding=true])
			in
			    Rows
