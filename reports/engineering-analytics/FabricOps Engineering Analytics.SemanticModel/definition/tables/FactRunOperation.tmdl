table FactRunOperation
	lineageTag: e64ac77d-6a5f-5581-9d11-877ab54d586e

	measure 'Rows Committed' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Committed rows] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ), KEEPFILTERS ( FactRunOperation[Asset type] = "Table" ) ) )
		lineageTag: 979eab4c-75c3-5e18-aa0e-30e6dcb42f96
		formatString: #,0

	measure 'Rows Inserted' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Inserted rows] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ), KEEPFILTERS ( FactRunOperation[Asset type] = "Table" ) ) )
		lineageTag: 5f7a70a2-b2ca-553e-954c-a2d88abdb58b
		formatString: #,0

	measure 'Rows Updated' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Updated rows] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ), KEEPFILTERS ( FactRunOperation[Asset type] = "Table" ) ) )
		lineageTag: 377663b1-fa84-5759-a7f7-431330991d33
		formatString: #,0

	measure 'Rows Unchanged' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Unchanged rows] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ), KEEPFILTERS ( FactRunOperation[Asset type] = "Table" ) ) )
		lineageTag: 63ea76d7-3ece-5c84-bfda-dda6a5b15644
		formatString: #,0

	measure 'Versions Inserted' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Inserted versions] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ), KEEPFILTERS ( FactRunOperation[Asset type] = "Table" ) ) )
		lineageTag: 12c136ab-e10f-5cdd-923c-412f11691179
		formatString: #,0

	measure 'Versions Expired' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Expired versions] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ), KEEPFILTERS ( FactRunOperation[Asset type] = "Table" ) ) )
		lineageTag: 8bc98087-f6bb-534e-acd8-fa3ebd5c4b66
		formatString: #,0

	measure 'Input Rows' =
			VAR Compatible = HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] )
			RETURN
			    IF ( Compatible, CALCULATE ( SUM ( FactRunOperation[Input row count] ), KEEPFILTERS ( FactRunOperation[Role] = "Write" ) ) )
		lineageTag: bc514336-dab3-5ce5-baef-4f0855306911
		formatString: #,0

	measure 'Rows Read' =
			IF ( HASONEVALUE ( FactRunOperation[Operation mode] ) && HASONEVALUE ( FactRunOperation[Asset type] ),
			    CALCULATE ( SUM ( FactRunOperation[Read row count] ), KEEPFILTERS ( FactRunOperation[Role] = "Read" ) ) )
		lineageTag: 20816350-1eaa-52fb-a47d-d137eddb8235
		formatString: #,0

	measure 'Started Operations' =
			COALESCE ( CALCULATE ( COUNTROWS ( FactRunOperation ), FactRunOperation[Started operation] = TRUE () ), 0 )
		lineageTag: d5e5dbe0-2d41-50b9-bdda-6061c9a53f23
		formatString: #,0

	measure 'Output Files' =
			IF ( HASONEVALUE ( FactRunOperation[Run operation key] ), SELECTEDVALUE ( FactRunOperation[File count] ) )
		lineageTag: c38f3ee3-225c-5632-8fec-d2a4a6c91f07
		formatString: #,0

	measure 'Output Bytes' =
			IF ( HASONEVALUE ( FactRunOperation[Run operation key] ), SELECTEDVALUE ( FactRunOperation[Byte count] ) )
		lineageTag: a4793c4f-f7ac-51f9-a057-6f2c0b354d6e
		formatString: #,0

	measure 'No Change Appends' =
			COALESCE ( CALCULATE ( COUNTROWS ( FactRunOperation ), KEEPFILTERS ( FactRunOperation[Started operation] = TRUE () ),
			    KEEPFILTERS ( FactRunOperation[Operation mode] = "append_new_only" ), FactRunOperation[Measurement source] = "no_unseen_hashes",
			    FactRunOperation[Inserted rows] == 0, FactRunOperation[Committed rows] == 0 ), 0 )
		lineageTag: e5431eb9-e82b-534a-919b-5af1a9f11463
		formatString: #,0

	measure 'Total Target Rows' =
			VAR Recorded = SELECTEDVALUE ( FactRunOperation[Profile row count] )
			VAR Asset = SELECTEDVALUE ( FactRunOperation[Asset key] )
			VAR Id = SELECTEDVALUE ( FactRunOperation[Run ID] )
			VAR Proof =
			    CALCULATE ( COUNTROWS ( FactProfileEvent ), FactProfileEvent[Run ID] = Id, FactProfileEvent[Asset key] = Asset,
			        FactProfileEvent[Activity] = "standard", FactProfileEvent[Trigger] = "write",
			        FactProfileEvent[Profile status] = "passed", FactProfileEvent[Persisted] = TRUE (),
			        FactProfileEvent[Profile scope] = "full_table", ISBLANK ( FactProfileEvent[Profile limit] ),
			        FactProfileEvent[Profile rows] = Recorded )
			RETURN IF ( HASONEVALUE ( FactRunOperation[Run operation key] ) && NOT ISBLANK ( Recorded ) && NOT ISBLANK ( Asset ) && Proof = 1, Recorded )
		lineageTag: 159668e1-960b-5379-8758-4a92db666e67
		formatString: #,0

	measure 'SCD1 Inserted' =
			VAR Input = SELECTEDVALUE ( FactRunOperation[Input row count] )
			VAR Inserted = SELECTEDVALUE ( FactRunOperation[Inserted rows] )
			VAR Updated = SELECTEDVALUE ( FactRunOperation[Updated rows] )
			VAR Unchanged = SELECTEDVALUE ( FactRunOperation[Unchanged rows] )
			VAR Measured = SELECTEDVALUE ( FactRunOperation[Measurement source] ) IN { "delta_merge", "warehouse_transaction", "delta_commit" }
			RETURN
			    IF ( HASONEVALUE ( FactRunOperation[Run operation key] ) && HASONEVALUE ( DimOperation[Series key] ) &&
			        SELECTEDVALUE ( FactRunOperation[Operation mode] ) = "scd1" && Measured &&
			        NOT ISBLANK ( Input ) && NOT ISBLANK ( Inserted ) && NOT ISBLANK ( Updated ) && NOT ISBLANK ( Unchanged ) &&
			        Inserted + Updated + Unchanged = Input, Inserted )
		lineageTag: 9acdf138-de61-5db6-a121-b0b1f9492ddd
		formatString: #,0

	measure 'SCD1 Updated' =
			VAR Input = SELECTEDVALUE ( FactRunOperation[Input row count] )
			VAR Inserted = SELECTEDVALUE ( FactRunOperation[Inserted rows] )
			VAR Updated = SELECTEDVALUE ( FactRunOperation[Updated rows] )
			VAR Unchanged = SELECTEDVALUE ( FactRunOperation[Unchanged rows] )
			VAR Measured = SELECTEDVALUE ( FactRunOperation[Measurement source] ) IN { "delta_merge", "warehouse_transaction", "delta_commit" }
			RETURN
			    IF ( HASONEVALUE ( FactRunOperation[Run operation key] ) && HASONEVALUE ( DimOperation[Series key] ) &&
			        SELECTEDVALUE ( FactRunOperation[Operation mode] ) = "scd1" && Measured &&
			        NOT ISBLANK ( Input ) && NOT ISBLANK ( Inserted ) && NOT ISBLANK ( Updated ) && NOT ISBLANK ( Unchanged ) &&
			        Inserted + Updated + Unchanged = Input, Updated )
		lineageTag: c751b732-4303-58eb-9d3e-aa839176a06e
		formatString: #,0

	measure 'SCD1 Unchanged' =
			VAR Input = SELECTEDVALUE ( FactRunOperation[Input row count] )
			VAR Inserted = SELECTEDVALUE ( FactRunOperation[Inserted rows] )
			VAR Updated = SELECTEDVALUE ( FactRunOperation[Updated rows] )
			VAR Unchanged = SELECTEDVALUE ( FactRunOperation[Unchanged rows] )
			VAR Measured = SELECTEDVALUE ( FactRunOperation[Measurement source] ) IN { "delta_merge", "warehouse_transaction", "delta_commit" }
			RETURN
			    IF ( HASONEVALUE ( FactRunOperation[Run operation key] ) && HASONEVALUE ( DimOperation[Series key] ) &&
			        SELECTEDVALUE ( FactRunOperation[Operation mode] ) = "scd1" && Measured &&
			        NOT ISBLANK ( Input ) && NOT ISBLANK ( Inserted ) && NOT ISBLANK ( Updated ) && NOT ISBLANK ( Unchanged ) &&
			        Inserted + Updated + Unchanged = Input, Unchanged )
		lineageTag: d38237a0-c5a1-5cab-9b57-9926bccc0e97
		formatString: #,0

	measure 'Operation Duration Seconds' =
			IF ( HASONEVALUE ( FactRunOperation[Run operation key] ), SELECTEDVALUE ( FactRunOperation[Elapsed seconds] ) )
		lineageTag: 995d778d-7476-5553-911d-6ff438feb186
		formatString: #,0.00

	measure 'Previous Operation Duration Seconds' =
			VAR Cohort = SELECTEDVALUE ( FactRunOperation[Comparison cohort] )
			VAR Point = SELECTEDVALUE ( FactRunOperation[Run order] )
			VAR Dates = ALLSELECTED ( DimDate[UTC date] )
			VAR Options =
			    CALCULATETABLE (
			        FILTER ( FactRunOperation, FactRunOperation[Comparison cohort] = Cohort && FactRunOperation[Run order] < Point && NOT ISBLANK ( FactRunOperation[Elapsed seconds] ) ),
			        REMOVEFILTERS ( FactRunOperation ),
			        TREATAS ( Dates, FactPipelineRun[UTC date] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( Cohort ) && NOT ISBLANK ( [Operation Duration Seconds] ),
			        MAXX ( TOPN ( 1, Options, FactRunOperation[Run order], DESC ), FactRunOperation[Elapsed seconds] ) )
		lineageTag: ac35cc05-8e6e-56f8-ac96-db5344560111
		formatString: #,0.00

	measure 'Operation Duration Change Seconds' =
			VAR Previous = [Previous Operation Duration Seconds]
			RETURN IF ( NOT ISBLANK ( Previous ), [Operation Duration Seconds] - Previous )
		lineageTag: 05e288a9-cb17-5894-9d25-e23227aebd32
		formatString: #,0.00

	measure 'Selected Write Metric Title' =
			IF ( HASONEVALUE ( WriteMetric[Metric field] ), "Write volume · " & MAX ( WriteMetric[Write metric] ), "Select one write metric" )
		lineageTag: 289948cb-6396-579f-9491-fcbce17e6fe3

	measure 'Operation Duration Change Percent' =
			DIVIDE ( [Operation Duration Change Seconds], [Previous Operation Duration Seconds] )
		lineageTag: d44ebaf1-92a5-53d2-a346-f18a27955b3a
		formatString: +0.0%;-0.0%;0.0%

