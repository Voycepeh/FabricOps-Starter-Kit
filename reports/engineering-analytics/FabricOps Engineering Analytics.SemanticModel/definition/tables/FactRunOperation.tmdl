	partition FactRunOperation = m
		mode: import
		source =
			let
			    Source = Table.AddColumn(Operations, "WasStarted", each [Started] <> null, type logical),
			    Projected = Table.SelectColumns(Source, {"OperationKey", "RunId", "SeriesKey", "AssetKey", "RecordedKey", "TableId", "FileId", "Kind", "FileFormat", "Role", "OperationMode", "Status", "Started", "Completed", "Duration", "AssetLabel", "AssetWorkspace", "ContractId", "ContractVersion", "Publication", "RowsRead", "Columns", "InputRows", "Committed", "Inserted", "Updated", "Unchanged", "VersionsInserted", "VersionsExpired", "TargetRows", "OutputFiles", "OutputBytes", "Measurement", "Cohort", "RunOrder", "WasStarted"}),
			    Typed = Table.TransformColumnTypes(Projected, {{"OperationKey", type text}, {"RunId", type text}, {"SeriesKey", type text}, {"AssetKey", type text}, {"RecordedKey", type text}, {"TableId", type text}, {"FileId", type text}, {"Kind", type text}, {"FileFormat", type text}, {"Role", type text}, {"OperationMode", type text}, {"Status", type text}, {"Started", type datetime}, {"Completed", type datetime}, {"Duration", type number}, {"AssetLabel", type text}, {"AssetWorkspace", type text}, {"ContractId", type text}, {"ContractVersion", Int64.Type}, {"Publication", type text}, {"RowsRead", Int64.Type}, {"Columns", Int64.Type}, {"InputRows", Int64.Type}, {"Committed", Int64.Type}, {"Inserted", Int64.Type}, {"Updated", Int64.Type}, {"Unchanged", Int64.Type}, {"VersionsInserted", Int64.Type}, {"VersionsExpired", Int64.Type}, {"TargetRows", Int64.Type}, {"OutputFiles", Int64.Type}, {"OutputBytes", Int64.Type}, {"Measurement", type text}, {"Cohort", type text}, {"RunOrder", Int64.Type}, {"WasStarted", type logical}}, "en-US")
			in
			    Typed
