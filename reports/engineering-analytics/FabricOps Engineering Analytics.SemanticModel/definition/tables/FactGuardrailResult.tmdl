table FactGuardrailResult
	lineageTag: b4a9770b-7ef1-52c2-904e-6ec866ee87ba

	measure 'Checks Evaluated' =
			COALESCE ( CALCULATE ( DISTINCTCOUNT ( FactGuardrailResult[Guardrail Result ID] ), FactGuardrailResult[Evaluated] = TRUE () ), 0 )
		lineageTag: 3cf06c16-86fa-5dd4-a906-0d8a63bc9417
		formatString: #,0

	measure 'Checks Failed' =
			CALCULATE ( [Checks Evaluated], KEEPFILTERS ( FactGuardrailResult[Status] = "failed" ) )
		lineageTag: f34a8234-2680-51ef-a83a-9bf34bd1bc56
		formatString: #,0

	measure 'Checks Blocked' =
			COALESCE ( CALCULATE ( DISTINCTCOUNT ( FactGuardrailResult[Guardrail Result ID] ), FactGuardrailResult[Can continue] = FALSE () ), 0 )
		lineageTag: 9c5d765d-0311-5d8a-923c-2227604054d9
		formatString: #,0

