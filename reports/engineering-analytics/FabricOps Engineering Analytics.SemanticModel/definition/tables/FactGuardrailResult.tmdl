	partition FactGuardrailResult = m
		mode: import
		source =
			let
			    Source = Guardrails,
			    Projected = Table.SelectColumns(Source, {"ResultId", "RunId", "AssetKey", "AssetLabel", "RuleId", "GuardrailVersion", "ContractId", "ContractVersion", "Status", "Continue", "Severity", "GuardrailType", "RuleType", "Action", "Reason", "Evaluated"}),
			    Typed = Table.TransformColumnTypes(Projected, {{"ResultId", type text}, {"RunId", type text}, {"AssetKey", type text}, {"AssetLabel", type text}, {"RuleId", type text}, {"GuardrailVersion", Int64.Type}, {"ContractId", type text}, {"ContractVersion", Int64.Type}, {"Status", type text}, {"Continue", type logical}, {"Severity", type text}, {"GuardrailType", type text}, {"RuleType", type text}, {"Action", type text}, {"Reason", type text}, {"Evaluated", type logical}}, "en-US")
			in
			    Typed
