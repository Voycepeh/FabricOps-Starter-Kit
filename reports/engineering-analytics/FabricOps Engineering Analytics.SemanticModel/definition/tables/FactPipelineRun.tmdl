		lineageTag: 7644d517-7b2c-5f15-99bb-e2e2edf596af

	measure 'Point Operation status' =
			SELECTEDVALUE ( FactRunOperation[Operation status] )
		lineageTag: 6b56cf72-e4a6-54bd-9ec9-08636d7be951

	measure 'Point Strategy' =
			SELECTEDVALUE ( FactRunOperation[Operation mode] )
		lineageTag: b4b2fe27-9f81-5907-b86a-927cce46303d

	measure 'Point Measurement source' =
			SELECTEDVALUE ( FactRunOperation[Measurement source] )
		lineageTag: a19c2789-bde3-5efa-824a-80147b051db9

	measure 'Point File publication' =
			SELECTEDVALUE ( FactRunOperation[File publication status] )
		lineageTag: c05ed6dd-68e2-5623-990e-7508bd4483ce

	measure 'Point Snapshot ID' =
			SELECTEDVALUE ( FactTableProfile[Snapshot ID] )
		lineageTag: 4bdaeea3-0c15-5460-bfac-c7d4bcdc4a96

	measure 'Point Snapshot UTC' =
			SELECTEDVALUE ( FactTableProfile[Snapshot UTC] )
		lineageTag: b2a3ddc3-46f8-522c-9b88-fed3fcddebe5
		formatString: yyyy-MM-dd HH:mm:ss

	measure 'Run Success Rate' =
			DIVIDE ( [Successful Runs], [Successful Runs] + [Failed Runs] )
		lineageTag: e187e04e-7352-5d33-839c-32bd9e0b80d4
		formatString: 0.0%

	measure 'Pipeline Duration Seconds' =
			IF ( HASONEVALUE ( FactPipelineRun[Run ID] ) && [Run Count] = 1, SELECTEDVALUE ( FactPipelineRun[Elapsed seconds] ) )
		lineageTag: 74ea4e2f-e022-5554-afec-b2ef7a1eae48
		formatString: #,0.00

	measure 'Run Duration Change Percent' =
			DIVIDE ( [Run Duration Change Seconds], [Previous Run Duration Seconds] )
		lineageTag: 1ab9628b-72e5-58e9-b637-87de64b970d0
		formatString: +0.0%;-0.0%;0.0%

	measure 'Previous Run Duration Seconds' =
			VAR Cohort = SELECTEDVALUE ( FactPipelineRun[Comparison cohort] )
			VAR Point = SELECTEDVALUE ( FactPipelineRun[Run order] )
			VAR Dates = ALLSELECTED ( DimDate[UTC date] )
			VAR Options =
			    CALCULATETABLE (
			        FILTER ( FactPipelineRun, FactPipelineRun[Comparison cohort] = Cohort && FactPipelineRun[Run order] < Point && NOT ISBLANK ( FactPipelineRun[Elapsed seconds] ) ),
			        REMOVEFILTERS ( FactPipelineRun ),
			        TREATAS ( Dates, FactPipelineRun[UTC date] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( Cohort ) && NOT ISBLANK ( [Pipeline Duration Seconds] ),
			        MAXX ( TOPN ( 1, Options, FactPipelineRun[Run order], DESC ), FactPipelineRun[Elapsed seconds] ) )
		lineageTag: e4f4f493-e08c-5232-86b7-4f9f851a20cb
		formatString: #,0.00

	measure 'Run Duration Change Seconds' =
			VAR Previous = [Previous Run Duration Seconds]
			RETURN IF ( NOT ISBLANK ( Previous ), [Pipeline Duration Seconds] - Previous )
		lineageTag: 2aced6b1-a0d5-51ae-98f0-1337484159a3
		formatString: #,0.00

