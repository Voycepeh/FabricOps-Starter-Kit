table FactPipelineRun
	lineageTag: 8b44dbbe-fc24-5189-b95a-9e154675a469

	measure 'Run Count' =
			VAR AssetFiltered = ISCROSSFILTERED ( DimTable[Asset key] )
			VAR AssetRuns = CALCULATETABLE ( VALUES ( FactRunOperation[Run ID] ), FactRunOperation[Started operation] = TRUE () )
			RETURN
			    IF ( AssetFiltered, CALCULATE ( COALESCE ( DISTINCTCOUNT ( FactPipelineRun[Run ID] ), 0 ), KEEPFILTERS ( TREATAS ( AssetRuns, FactPipelineRun[Run ID] ) ) ), COALESCE ( DISTINCTCOUNT ( FactPipelineRun[Run ID] ), 0 ) )
		lineageTag: 6aee578a-9a14-5ff9-9f38-e5a5e2d6af09
		formatString: #,0

	measure 'Unique Pipelines' =
			VAR AssetFiltered = ISCROSSFILTERED ( DimTable[Asset key] )
			VAR AssetRuns = CALCULATETABLE ( VALUES ( FactRunOperation[Run ID] ), FactRunOperation[Started operation] = TRUE () )
			RETURN
			    IF ( AssetFiltered, CALCULATE ( COALESCE ( DISTINCTCOUNT ( FactPipelineRun[Pipeline key] ), 0 ), KEEPFILTERS ( TREATAS ( AssetRuns, FactPipelineRun[Run ID] ) ) ), COALESCE ( DISTINCTCOUNT ( FactPipelineRun[Pipeline key] ), 0 ) )
		lineageTag: 5952ff5c-fec1-5036-995e-80e026464583
		formatString: #,0

	measure 'Successful Runs' =
			CALCULATE ( [Run Count], KEEPFILTERS ( FactPipelineRun[Outcome] = "Success" ) )
		lineageTag: 92a2b93e-4235-51c8-b28c-8ceacb429306
		formatString: #,0

	measure 'Failed Runs' =
			CALCULATE ( [Run Count], KEEPFILTERS ( FactPipelineRun[Outcome] = "Failed" ) )
		lineageTag: 1cde9f7d-14ba-5d69-bfd8-06ffaf3cdf26
		formatString: #,0

	measure 'Incomplete Runs' =
			CALCULATE ( [Run Count], KEEPFILTERS ( FactPipelineRun[Outcome] = "Incomplete" ) )
		lineageTag: aa52eddf-82e5-5bc4-9769-2033343cffc6
		formatString: #,0

	measure 'Show Matching Run' =
			IF ( HASONEVALUE ( FactPipelineRun[Run ID] ) && [Run Count] = 1, 1 )
		lineageTag: 3a33a212-afc0-5394-b958-6bc7bc631f56
		formatString: #,0

	measure 'Show One Pipeline' =
			IF ( HASONEVALUE ( DimPipeline[Pipeline key] ), 1 )
		lineageTag: 0431389e-daac-5a90-93bf-03d1c3a315d8
		formatString: #,0

	measure 'Show One Asset' =
			IF ( HASONEVALUE ( DimTable[Asset key] ), 1 )
		lineageTag: 75a6b5e5-65a4-5e77-bc47-cf18f58ff223
		formatString: #,0

	measure 'Show Run Detail' =
			IF ( HASONEVALUE ( FactPipelineRun[Run ID] ), 1 )
		lineageTag: d8103e70-b963-59d2-9de2-7b34d09c34e5
		formatString: #,0

	measure 'Show Latest Run Row' =
			IF ( SELECTEDVALUE ( FactPipelineRun[Run ID] ) = SELECTEDVALUE ( DimPipeline[Latest Run ID] ) && [Latest Pipeline Visible] = 1, 1 )
		lineageTag: 2a38f473-6d02-5d4f-a1a0-585db558b61d

	measure 'Point Run ID' =
			SELECTEDVALUE ( FactPipelineRun[Run ID] )
		lineageTag: dc065d3e-3c4a-5733-a9e6-93121f6a7f9a

