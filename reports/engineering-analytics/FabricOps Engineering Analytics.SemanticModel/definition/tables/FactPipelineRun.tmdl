	partition FactPipelineRun = m
		mode: import
		source =
			let
			    Source = Runs,
			    Projected = Table.SelectColumns(Source, {"RunId", "PipelineKey", "WorkspaceId", "Mode", "Started", "Completed", "UtcDate", "Duration", "Status", "Outcome", "Boundary", "Identity", "Version", "SchemaVersion", "Notebook", "RunPoint", "RunOrder", "CohortNumber", "FailureSummary"}),
			    Typed = Table.TransformColumnTypes(Projected, {{"RunId", type text}, {"PipelineKey", type text}, {"WorkspaceId", type text}, {"Mode", type text}, {"Started", type datetime}, {"Completed", type datetime}, {"UtcDate", type date}, {"Duration", type number}, {"Status", type text}, {"Outcome", type text}, {"Boundary", type logical}, {"Identity", type text}, {"Version", Int64.Type}, {"SchemaVersion", Int64.Type}, {"Notebook", type text}, {"RunPoint", type text}, {"RunOrder", Int64.Type}, {"CohortNumber", Int64.Type}, {"FailureSummary", type text}}, "en-US")
			in
			    Typed
