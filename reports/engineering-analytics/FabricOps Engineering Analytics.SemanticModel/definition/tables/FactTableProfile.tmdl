table FactTableProfile
	lineageTag: 1eadedbb-fa9f-55a1-8b11-b5b7852fe2ae

	measure 'Profiled Table Row Count' =
			IF ( HASONEVALUE ( FactTableProfile[Snapshot key] ), SELECTEDVALUE ( FactTableProfile[Physical rows] ) )
		lineageTag: 48cf22f8-28ec-5766-bb11-511edbcadd49
		formatString: #,0

	measure 'Previous Table Row Count' =
			VAR Point = SELECTEDVALUE ( FactTableProfile[Snapshot order] )
			VAR Asset = SELECTEDVALUE ( FactTableProfile[Asset key] )
			VAR Dates = ALLSELECTED ( DimDate[UTC date] )
			VAR Options =
			    CALCULATETABLE (
			        FILTER ( FactTableProfile, FactTableProfile[Asset key] = Asset && FactTableProfile[Snapshot order] < Point ),
			        REMOVEFILTERS ( FactTableProfile ), TREATAS ( Dates, FactTableProfile[UTC date] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( Point ), MAXX ( TOPN ( 1, Options, FactTableProfile[Snapshot order], DESC ), FactTableProfile[Physical rows] ) )
		lineageTag: 2ba31e23-d0d7-5ef3-a2b2-858598f94d93
		formatString: #,0

	measure 'Table Row Count Change' =
			VAR Previous = [Previous Table Row Count]
			RETURN IF ( NOT ISBLANK ( Previous ), [Profiled Table Row Count] - Previous )
		lineageTag: d44c2383-c3ba-523c-a900-d58bde9e3f6b
		formatString: #,0

	measure 'Table Row Count Change Percent' =
			DIVIDE ( [Table Row Count Change], [Previous Table Row Count] )
		lineageTag: 212061f8-a06b-50fb-8b1a-9ae997725492
		formatString: +0.0%;-0.0%;0.0%

