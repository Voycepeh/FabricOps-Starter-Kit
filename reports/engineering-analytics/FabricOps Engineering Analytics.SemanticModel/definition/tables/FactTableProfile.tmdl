	partition FactTableProfile = m
		mode: import
		source =
			let
			    Source = TableProfiles,
			    Projected = Table.SelectColumns(Source, {"SnapshotKey", "Snapshot", "AssetKey", "SnapshotUtc", "UtcDate", "SnapshotPoint", "RowCount", "SnapshotOrder", "ProfileScope"}),
			    Typed = Table.TransformColumnTypes(Projected, {{"SnapshotKey", type text}, {"Snapshot", type text}, {"AssetKey", type text}, {"SnapshotUtc", type datetime}, {"UtcDate", type date}, {"SnapshotPoint", type text}, {"RowCount", Int64.Type}, {"SnapshotOrder", Int64.Type}, {"ProfileScope", type text}}, "en-US")
			in
			    Typed
