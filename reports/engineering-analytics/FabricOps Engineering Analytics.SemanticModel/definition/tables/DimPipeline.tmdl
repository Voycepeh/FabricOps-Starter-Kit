	partition DimPipeline = m
		mode: import
		source =
			let
			    Source = Pipelines,
			    Projected = Table.SelectColumns(Source, {"PipelineKey", "WorkspaceId", "PipelineId", "Workspace", "Label", "LatestRunId", "LatestStatus", "LatestOutcome", "LatestUtc", "LatestDuration", "LatestFailure", "Notebook"}),
			    Typed = Table.TransformColumnTypes(Projected, {{"PipelineKey", type text}, {"WorkspaceId", type text}, {"PipelineId", type text}, {"Workspace", type text}, {"Label", type text}, {"LatestRunId", type text}, {"LatestStatus", type text}, {"LatestOutcome", type text}, {"LatestUtc", type datetime}, {"LatestDuration", type number}, {"LatestFailure", type text}, {"Notebook", type text}}, "en-US")
			in
			    Typed
