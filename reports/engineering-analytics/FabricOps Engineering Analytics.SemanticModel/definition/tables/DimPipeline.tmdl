table DimPipeline
	lineageTag: 6c1a05db-86e7-59c3-b359-3ec35f191f0e

	measure 'Latest Pipeline Visible' =
			VAR Id = SELECTEDVALUE ( DimPipeline[Latest Run ID] )
			VAR MatchCount = CALCULATE ( [Started Operations], REMOVEFILTERS ( FactPipelineRun ), REMOVEFILTERS ( DimDate ),
			    REMOVEFILTERS ( DimMode ), TREATAS ( { Id }, FactPipelineRun[Run ID] ), VALUES ( DimTable[Asset key] ) )
			RETURN IF ( NOT ISBLANK ( Id ) && ( NOT ISCROSSFILTERED ( DimTable[Asset key] ) || MatchCount > 0 ), 1 )
		lineageTag: 0761fb05-b75a-548c-86a7-a51c5ea64366
		formatString: #,0

	measure 'Current Failed Pipelines' =
			COALESCE ( COUNTROWS ( FILTER ( VALUES ( DimPipeline[Pipeline key] ),
			    CALCULATE ( SELECTEDVALUE ( DimPipeline[Latest status] ) ) = "failed" && [Latest Pipeline Visible] = 1 ) ), 0 )
		lineageTag: 3bb52312-e98f-55dd-a7f7-92bdef9029bc
		formatString: #,0

	measure 'Latest Read Attempts' =
			VAR Id = SELECTEDVALUE ( DimPipeline[Latest Run ID] )
			VAR Assets = VALUES ( DimTable[Asset key] )
			VAR Filtered = ISCROSSFILTERED ( DimTable[Asset key] )
			VAR CountForRun = CALCULATE ( [Started Operations], REMOVEFILTERS ( FactPipelineRun ), REMOVEFILTERS ( DimMode ), REMOVEFILTERS ( DimDate ),
			    TREATAS ( { Id }, FactPipelineRun[Run ID] ), FactRunOperation[Role] = "Read" )
			VAR CountForAsset = CALCULATE ( [Started Operations], REMOVEFILTERS ( FactPipelineRun ), REMOVEFILTERS ( DimMode ), REMOVEFILTERS ( DimDate ),
			    TREATAS ( { Id }, FactPipelineRun[Run ID] ), TREATAS ( Assets, DimTable[Asset key] ), FactRunOperation[Role] = "Read" )
			RETURN IF ( NOT ISBLANK ( Id ), IF ( Filtered, CountForAsset, CountForRun ) )
		lineageTag: 54df56a3-999c-5779-9670-d28ebf076fb2
		formatString: #,0

