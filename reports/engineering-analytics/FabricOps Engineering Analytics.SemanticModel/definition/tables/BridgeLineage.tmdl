	partition BridgeLineage = m
		mode: import
		source =
			let
			    Source = Lineage,
			    Projected = Table.SelectColumns(Source, {"EdgeKey", "PipelineKey", "RunId", "SourceKey", "SourceKind", "Source", "SourceWorkspace", "TargetKey", "TargetKind", "Target", "TargetWorkspace", "Resolution", "FirstUtc", "LastUtc"}),
			    Typed = Table.TransformColumnTypes(Projected, {{"EdgeKey", type text}, {"PipelineKey", type text}, {"RunId", type text}, {"SourceKey", type text}, {"SourceKind", type text}, {"Source", type text}, {"SourceWorkspace", type text}, {"TargetKey", type text}, {"TargetKind", type text}, {"Target", type text}, {"TargetWorkspace", type text}, {"Resolution", type text}, {"FirstUtc", type datetime}, {"LastUtc", type datetime}}, "en-US")
			in
			    Typed
