table BridgeLineage
	lineageTag: 896b959e-421f-5f6b-929e-a8388bfa9ab9

	measure 'Show Known Edge' =
			VAR Root = SELECTEDVALUE ( DimLineageRoot[Root key] )
			VAR Source = SELECTEDVALUE ( BridgeLineage[Source key] )
			VAR Target = SELECTEDVALUE ( BridgeLineage[Target key] )
			VAR Down = CALCULATETABLE ( VALUES ( FactDependencyReach[Node key] ), FactDependencyReach[Direction] = "Downstream" )
			VAR Up = CALCULATETABLE ( VALUES ( FactDependencyReach[Node key] ), FactDependencyReach[Direction] = "Upstream" )
			VAR Upstream = ( Source = Root || Source IN Up ) && ( Target = Root || Target IN Up )
			VAR Downstream = ( Source = Root || Source IN Down ) && ( Target = Root || Target IN Down )
			RETURN IF ( ISBLANK ( Root ) || Upstream || Downstream || Source = Root || Target = Root, 1 )
		lineageTag: 28517d6c-7f86-5b99-9ea7-4e7204dd9a28
		formatString: #,0

	column 'Edge key'
		dataType: string
		sourceColumn: EdgeKey
		summarizeBy: none
		lineageTag: 44b303ee-279f-5175-9474-1877de4430d7
		isHidden
		isKey

	column 'Pipeline key'
		dataType: string
		sourceColumn: PipelineKey
		summarizeBy: none
		lineageTag: 07075e14-7140-5f36-851a-6e9686dfcc6d
		isHidden

	column 'Reference Run ID'
